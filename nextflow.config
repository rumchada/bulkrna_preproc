profiles {

    standard {

        process {
            executor = 'local'
            container = 'gbolden101/bulk-rna-pipeline:1.0'
        }

        //projectDir = '/Users/gbolden/Desktop/SMR2026/adv_assigment/scripts/rna_bulk.nf'
        //Unrecognized config option 'projectDir'
        docker.enabled = true
        workDir = '/Users/gbolden/Desktop/SMR2026/adv_assignment/work'
    }
        //I'd prefer errorStrategies in 
    //end of standard process bracket

    aws {

        process {
            executor = 'awsbatch'
            queue = 'nextflow-queue'

            container = '808433582956.dkr.ecr.us-east-2.amazonaws.com/gbolden_nextflow:bulk-rna-pipeline'

            cpus = 1
            memory = '2 GB'
        }

        workDir = 's3://gbolden-nextflow/work'
        wave.enabled = true
        fusion.enabled = true
        docker.enabled = true

        aws {
            region = 'us-east-2'

            batch {
                cliPath = '/Users/gbolden/.local/bin/aws'
            }
        }
    }
}
