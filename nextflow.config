docker {
    enabled = true
}
process {
    container = "gbolden101/bulk-rna-pipeline:1.0"
}

//New line for AWS registry
plugins {
id 'nf-wave'
id 'nf-amazon'
}
wave {
enabled = true
}
fusion {
enabled = true
}

//process for AWS
process {
    executor = 'awsbatch'
    container = '808433582956.dkr.ecr.us-east-2.amazonaws.com/gbolden_nextflow:bulk-rna-pipeline'
    queue = 'nextflow-queue'

    //need cpus and threads for the session
    cpus = 1
    memory = '2 GB'

    //I'd prefer errorStrategies in 

}//end of process bracket

aws {
    region = 'us-east-2'
    batch {
        cliPath = '/Users/gbolden/.local/bin/aws'
        volumes = '/fusion'
    }
}//end of aws direct config

workDir = 's3://gbolden-nextflow/work'


plugins {
id 'nf-wave'
id 'nf-amazon'
}

wave {
enabled = true
}

fusion {
enabled = true
}

